    return Version{@PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@};
    // clang-format on
}

/// Version formatted as "major.minor.patch".
[[nodiscard]] std::string versionString();

